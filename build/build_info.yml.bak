cmake:
  board:
    name: 'xiao_nrf54l15'
    path:
     - 'C:/ncs/main/zephyr/boards/seeed/xiao_nrf54l15'
    qualifiers: 'nrf54l15/cpuapp'
    revision: ''
  images:
   - name: 'led_strip'
     source-dir: 'C:/old_nrfprojects/WS2812_nrf54l15/led_strip'
     type: 'MAIN'
  kconfig:
    files:
     - 'C:/old_nrfprojects/WS2812_nrf54l15/led_strip/build/_sysbuild/empty.conf'
     - 'c:/old_nrfprojects/WS2812_nrf54l15/led_strip/sysbuild.conf'
    user-files:
     - 'c:/old_nrfprojects/WS2812_nrf54l15/led_strip/sysbuild.conf'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\c1a76fddb2\opt\bin\Scripts\west build --build-dir c:/old_nrfprojects/WS2812_nrf54l15/led_strip/build c:/old_nrfprojects/WS2812_nrf54l15/led_strip --pristine --board xiao_nrf54l15/nrf54l15/cpuapp --sysbuild -- -DCONF_FILE=prj.conf'
  topdir: 'c:\ncs\main'
  version: '1.4.0'
